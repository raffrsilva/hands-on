
import java.util.Scanner;

public class Atividade24 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Quantidade de crianças: ");
        int n = sc.nextInt();

        int meninas = 0, meninos = 0;
        int meninasMortas = 0, meninosMortos = 0;
        int ate24Meses = 0;

        for (int i = 1; i <= n; i++) {
            System.out.print("Sexo (M/F): ");
            char sexo = sc.next().toUpperCase().charAt(0);

            System.out.print("Tempo de vida em meses: ");
            int meses = sc.nextInt();

            if (sexo == 'F') {
                meninas++;

                if (meses <= 24) {
                    meninasMortas++;
                }
            } else if (sexo == 'M') {
                meninos++;

                if (meses <= 24) {
                    meninosMortos++;
                }
            }

            if (meses <= 24) {
                ate24Meses++;
            }
        }

        if (meninas > 0) {
            System.out.println("Mortalidade feminina: "
                    + (meninasMortas * 100.0 / meninas) + "%");
        } else {
            System.out.println("Não há crianças do sexo feminino.");
        }

        if (meninos > 0) {
            System.out.println("Mortalidade masculina: "
                    + (meninosMortos * 100.0 / meninos) + "%");
        } else {
            System.out.println("Não há crianças do sexo masculino.");
        }

        if (n > 0) {
            System.out.println("Crianças com até 24 meses: "
                    + (ate24Meses * 100.0 / n) + "%");
        }

        sc.close();
    }
}
