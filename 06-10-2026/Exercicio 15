
import java.util.Scanner;

public class Atividade15 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n;
        double soma = 0;

        System.out.print("Digite N: ");
        n = sc.nextInt();

        for (int i = 1; i <= n; i++) {
            soma += 1.0 / i;

            if (i == 1) {
                System.out.print("1");
            } else {
                System.out.print(" + 1/" + i);
            }
        }

        System.out.printf("%nS = %.2f%n", soma);

        sc.close();
    }
}
