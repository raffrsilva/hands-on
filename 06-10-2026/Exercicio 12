
import java.util.Scanner;

public class Atividade12 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int idade;
        int maiorIdade = 0;
        int mulheres = 0;
        boolean primeira = true;

        while (true) {
            System.out.print("Idade (-1 encerra): ");
            idade = sc.nextInt();

            if (idade == -1) {
                break;
            }

            System.out.print("Sexo (M/F): ");
            char sexo = sc.next().toUpperCase().charAt(0);

            System.out.print("Olhos (azuis, verdes, castanhos): ");
            String olhos = sc.next().toLowerCase();

            System.out.print("Cabelos (louros, castanhos, pretos): ");
            String cabelos = sc.next().toLowerCase();

            if (primeira || idade > maiorIdade) {
                maiorIdade = idade;
                primeira = false;
            }

            if (sexo == 'F' && idade >= 18 && idade <= 35
                    && olhos.equals("verdes")
                    && cabelos.equals("louros")) {
                mulheres++;
            }
        }

        if (!primeira) {
            System.out.println("Maior idade: " + maiorIdade);
        } else {
            System.out.println("Nenhuma pessoa pesquisada.");
        }

        System.out.println("Mulheres que atendem aos critérios: "
                + mulheres);

        sc.close();
    }
}
