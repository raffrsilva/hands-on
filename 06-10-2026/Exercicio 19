
import java.util.Scanner;

public class Atividade19 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] faixas = new int[5];

        for (int i = 1; i <= 15; i++) {
            System.out.print("Digite a idade: ");
            int idade = sc.nextInt();

            if (idade <= 15) {
                faixas[0]++;
            } else if (idade <= 30) {
                faixas[1]++;
            } else if (idade <= 45) {
                faixas[2]++;
            } else if (idade <= 60) {
                faixas[3]++;
            } else {
                faixas[4]++;
            }
        }

        for (int i = 0; i < 5; i++) {
            System.out.println("Faixa " + (i + 1)
                    + ": " + faixas[i] + " pessoas");
        }

        System.out.println("Percentual da primeira faixa: "
                + (faixas[0] * 100.0 / 15) + "%");

        System.out.println("Percentual da última faixa: "
                + (faixas[4] * 100.0 / 15) + "%");

        sc.close();
    }
}
