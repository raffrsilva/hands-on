programa
{
    funcao inicio()
    {
        inteiro idade
        logico maiorDeIdade

        escreva("Digite sua idade: ")
        leia(idade)

        maiorDeIdade = idade >= 18

        escreva("É maior de idade? ", maiorDeIdade)
    }
}
