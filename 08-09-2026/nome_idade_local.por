programa
{
    funcao inicio()
    {
        cadeia nome
        inteiro idade
        cadeia cidade

        escreva("Digite seu nome: ")
        leia(nome)

        escreva("Digite sua idade: ")
        leia(idade)

        escreva("Digite sua cidade: ")
        leia(cidade)

        escreva("Meu nome é ", nome, ", tenho ", idade, " anos e moro em ", cidade, ".")
    }
}
