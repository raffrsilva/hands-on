programa
{
    funcao inicio()
    {
    	//Operador e
        logico a
        logico b
        logico resultado

        escreva("Digite A (verdadeiro/falso): ")
        leia(a)

        escreva("Digite B (verdadeiro/falso): ")
        leia(b)

        resultado = a e b

        escreva("A e B = ", resultado)
    }
}
