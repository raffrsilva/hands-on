programa
{
    funcao inicio()
    {
        cadeia nome
        cadeia sobrenome
        cadeia usuario

        escreva("Digite seu primeiro nome: ")
        leia(nome)

        escreva("Digite seu sobrenome: ")
        leia(sobrenome)

        usuario = nome + sobrenome +221

        escreva("Nome de usuário: ", usuario)
    }
}
