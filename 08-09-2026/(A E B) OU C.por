programa
{
    funcao inicio()
    {
        logico a
        logico b
        logico c
        logico resultado

        escreva("Digite A: (verdadeiro/falso) ")
        leia(a)

        escreva("Digite B: (verdadeiro/falso) ")
        leia(b)

        escreva("Digite C: (verdadeiro/falso) ")
        leia(c)

        resultado = (a e b) ou c

        escreva("(A E B) OU C = ", resultado)
    }
}
