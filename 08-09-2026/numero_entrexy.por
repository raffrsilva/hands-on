programa
{
    funcao inicio()
    {
        real numero
        real x
        real y
        logico estaEntre

        escreva("Digite o número: ")
        leia(numero)

        escreva("Digite X: ")
        leia(x)

        escreva("Digite Y: ")
        leia(y)

        estaEntre = numero >= x e numero <= y

        escreva("O número está entre X e Y? ", estaEntre)
    }
}
