programa
{
    funcao inicio()
    {
        real distancia
        real litros
        real consumo

        escreva("Digite a distância percorrida em km: ")
        leia(distancia)

        escreva("Digite a quantidade de litros utilizada: ")
        leia(litros)

        consumo = distancia / litros

        escreva("Consumo médio = ", consumo, " km/l")
    }
}
