programa {
  funcao inicio() {
    /* Programa que soma dois numeros inteiros, variaveis de entrada n1, n2
    Variavel de saida: soma*/
    inteiro n1, n2, soma, subtracao, divisao, multiplicacao
    escreva ("Informe um numero:")
    leia (n1)
    escreva ("Informe outro numero:")
    leia (n2)
    soma = n1 + n2
    escreva ("O resultado da soma destes dois numero é: ", + soma + "\n" ) 
     subtracao = n1 - n2
    escreva ("O resultado da subtração dos numeros informados é: ", + subtracao + "\n")
    divisao = n1 / n2
    escreva ("O resultado da divisão dos numeros informados é: ", + divisao + "\n") 
    multiplicacao = n1*n2
    escreva ("O resultado da multiplicação dos numeros informados é: ", + multiplicacao + "\n")


  
  }

}
